/* 连接器绑定页样式 */
.container { padding: 24rpx; }
.page-title { font-size: 40rpx; font-weight: 500; margin-bottom: 8rpx; }
.page-sub { font-size: 24rpx; color: #666; line-height: 1.6; margin-bottom: 20rpx; }
.hint { font-size: 24rpx; color: #999; margin: 24rpx 4rpx; }

.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.card-row { display: flex; align-items: flex-start; }
.grow { flex: 1; margin-right: 16rpx; }
.title-line { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.card-title { font-size: 30rpx; font-weight: 500; }
.card-desc { font-size: 24rpx; color: #666; line-height: 1.6; }

.action-col { display: flex; flex-direction: column; align-items: flex-end; gap: 12rpx; }
.status-chip { font-size: 24rpx; padding: 8rpx 16rpx; border-radius: 999rpx; background: #eaf3de; color: #3b6d11; }
.btn { font-size: 26rpx; border-radius: 12rpx; }
.btn-sm { padding: 0 20rpx; line-height: 56rpx; }
.btn-primary { background: #378add; color: #fff; }
.btn-secondary { background: #f1efe8; color: #444; }
.danger { color: #a32d2d; }

.tag { font-size: 22rpx; color: #888; background: #f3f0e7; border-radius: 8rpx; padding: 4rpx 12rpx; }
.tag-ok { color: #0f6e56; background: #e1f5ee; }

.guide { margin-top: 20rpx; background: #f6f8fb; border-radius: 12rpx; padding: 20rpx; }
.guide-title { font-size: 26rpx; font-weight: 500; margin-bottom: 12rpx; }
.guide-step { display: flex; align-items: flex-start; margin-bottom: 10rpx; }
.step-no { flex: none; width: 32rpx; height: 32rpx; line-height: 32rpx; text-align: center;
  background: #378add; color: #fff; border-radius: 50%; font-size: 22rpx; margin-right: 12rpx; }
.step-text { font-size: 24rpx; color: #444; line-height: 32rpx; }

.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.45);
  display: flex; align-items: flex-end; z-index: 99; }
.sheet { width: 100%; background: #fff; border-radius: 24rpx 24rpx 0 0; padding: 32rpx 32rpx 48rpx; }
.sheet-title { font-size: 32rpx; font-weight: 500; margin-bottom: 16rpx; }
.sheet-text { font-size: 26rpx; color: #444; line-height: 1.7; margin-bottom: 8rpx; }
.btn-block { width: 100%; margin-top: 20rpx; }
