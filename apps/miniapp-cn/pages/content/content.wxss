/* pages/content/content.wxss */

/* 横向滚动分段（标签多时） */
.segment.scroll { overflow-x: auto; white-space: nowrap; }
.segment.scroll .segment-item { flex: 0 0 auto; padding: 16rpx 28rpx; }

/* 相册 */
.album-item {
  background: #FFFFFF;
  border: 1rpx solid #e5e1d6;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 18rpx;
}
.album-thumb {
  width: 100%;
  height: 320rpx;
  border-radius: 12rpx;
  background: #f3f0e7;
}
.album-meta { display: flex; align-items: center; gap: 14rpx; margin-top: 14rpx; }
.album-meta .input { flex: 1; }

/* 周期分段（月付 / 年付） */
.seg-row { display: flex; background: #e9e5da; border-radius: 14rpx; padding: 6rpx; }
.seg { flex: 1; text-align: center; padding: 16rpx 0; font-size: 27rpx; color: #6a6c64; border-radius: 10rpx; }
.seg-active { background: #FFFFFF; color: #11130f; font-weight: 600; box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.08); }

/* 两列并排（日期 / 时间） */
.row-flex { display: flex; align-items: flex-end; gap: 16rpx; margin-top: 12rpx; }
.flex-col { flex: 1; }
