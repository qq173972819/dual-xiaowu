<!-- 设备选择页（Page 1） -->
<view class="container">
  <view class="page-title">选择设备</view>
  <view class="page-sub">切换你要管理的双屏墨看板</view>

  <view wx:for="{{devices}}" wx:key="sn" class="card card-row" bindtap="onSelect" data-index="{{index}}">
    <view style="flex:1">
      <view class="card-title">{{item.name}}</view>
      <view class="card-desc">SN:{{item.sn}} ｜ {{item.stage}}</view>
    </view>
    <view>
      <text wx:if="{{item.online}}" class="tag tag-ok">在线</text>
      <text wx:else class="tag tag-off">离线</text>
    </view>
  </view>

  <view wx:if="{{devices.length===0}}" class="hint">暂无绑定设备，请先在 Web 管理后台绑定双屏设备。</view>

  <button class="btn btn-ghost btn-block" bindtap="onBack">返回首页</button>
</view>
